{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ark.example/schemas/tts-job.v1.json",
  "title": "ark.tts-job.v1",
  "description": "批量合成任务。每条 item 必须在 text 与 text_file 之间二选一，id 唯一。",
  "type": "object",
  "required": ["schema", "items"],
  "additionalProperties": true,
  "properties": {
    "schema": { "const": "ark.tts-job.v1" },
    "name": { "type": "string" },
    "engine": { "enum": ["auto", "lstts", "melotts", "mock"] },
    "language": { "enum": ["ZH", "EN"] },
    "speed": { "type": "number", "exclusiveMinimum": 0 },
    "workers": { "type": "integer", "minimum": 1, "maximum": 8 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "text_file": { "type": "string" },
          "voice": { "type": "string" },
          "emotion": { "type": "string" },
          "language": { "enum": ["ZH", "EN"] },
          "speed": { "type": "number", "exclusiveMinimum": 0 },
          "timeout_s": { "type": "number", "exclusiveMinimum": 0 },
          "validate": { "type": "boolean" }
        }
      }
    }
  }
}
